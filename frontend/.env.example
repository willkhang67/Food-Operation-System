# Base URL of the Nest API. Server-only: the browser calls /api/* on this app,
# and the BFF route handlers forward to this host.
API_URL=http://localhost:5000

# Optional. How long a BFF -> API call may take before it is aborted.
# Raise it if the API is on a host with cold starts. Defaults to 20000.
# API_TIMEOUT_MS=20000

# Signing key for CSRF tokens. Required in production (minimum 32 characters);
# a built-in development value is used when this is unset outside production.
# Generate one with: openssl rand -base64 32
CSRF_SECRET=

# Shared secret that lets the API trust the client IP this proxy reports, so
# rate limiting is per visitor rather than per BFF instance. Must be identical
# to the backend's INTERNAL_PROXY_SECRET.
#
# Optional: when unset the API buckets by socket address instead, which is more
# restrictive rather than less. When set in production it must be at least 32
# characters, since a guessable value would let anyone spoof their IP.
# Generate one with: openssl rand -base64 32
INTERNAL_PROXY_SECRET=
