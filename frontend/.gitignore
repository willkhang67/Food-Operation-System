# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit real credentials
.env
.env.*
!.env.example
!.env*.example

# keys, certs, credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
**/credentials.json
**/service-account*.json
**/google-services.json
*.secret
secrets/
.secrets/

# vercel / cloud local config (often contains tokens)
.vercel
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts
