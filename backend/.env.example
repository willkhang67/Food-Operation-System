PORT=6000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=foodapp
DB_PASSWORD=foodapp
DB_NAME=food_db

# 32-byte keys, base64-encoded. Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=your-base64-32-byte-key
BLIND_INDEX_KEY=your-base64-32-byte-key

# Generate with: openssl rand -base64 48
JWT_SECRET=your-long-random-jwt-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-long-random-jwt-refresh-secret

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=aud
FRONTEND_URL=http://localhost:3000

# Shared secret with the frontend BFF. When a request carries it, the API trusts
# the x-client-ip header the BFF sends and rate limits per visitor instead of
# treating every request from the BFF as one client. Must be identical to the
# frontend's INTERNAL_PROXY_SECRET.
# Generate with: openssl rand -base64 32
INTERNAL_PROXY_SECRET=

# Logging. Defaults to "debug" outside production and "info" in production.
# LOG_LEVEL=info